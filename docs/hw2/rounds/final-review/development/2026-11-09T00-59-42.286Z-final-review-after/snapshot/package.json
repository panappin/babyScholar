{
  "name": "ai-research-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local scaffold for the AI Research Assistant.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/local-dev.mjs start",
    "dev:stop": "node scripts/local-dev.mjs stop",
    "storage:reset": "node scripts/local-dev.mjs reset",
    "dev:frontend": "vite",
    "dev:worker": "wrangler dev --config wrangler.jsonc --local --persist-to .wrangler/state --port 8787",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --config wrangler.jsonc --local --persist-to .wrangler/state",
    "worker:types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc",
    "storage:check": "node scripts/storage-check.mjs",
    "checks:prepare": "tsc --project tsconfig.worker.json --outDir .wrangler/check-worker --sourceMap false",
    "integrations": "npm run integrations:offline",
    "integrations:offline": "npm run checks:prepare && node scripts/integration-offline-check.mjs",
    "integrations:live": "node scripts/integration-check.mjs",
    "papers": "npm run checks:prepare && node scripts/paper-search-check.mjs",
    "papers:check": "npm run papers",
    "papers:live": "node scripts/paper-search-live-check.mjs",
    "papers:ui:check": "node scripts/frontend-search-browser-check.mjs",
    "documents:ui:check": "node scripts/frontend-search-browser-check.mjs",
    "documents:check": "node scripts/document-check.mjs",
    "extractions:check": "node scripts/extraction-check.mjs",
    "metadata:check": "node scripts/metadata-check.mjs",
    "summaries": "node scripts/summary-check.mjs",
    "questions": "node scripts/question-check.mjs",
    "metadata:live": "node scripts/metadata-live-check.mjs",
    "metadata:live:offline": "node scripts/metadata-live-verifier-check.mjs",
    "unpdf:proof": "node scripts/unpdf-worker-proof.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.worker.json && tsc --noEmit --project tsconfig.vite.json",
    "build": "npm run typecheck && npm run build:frontend && npm run build:worker && npm run build:sites",
    "build:sites": "node scripts/prepare-sites-build.mjs",
    "sites": "npm run sites:check",
    "sites:check": "node scripts/sites-artifact-check.mjs",
    "build:frontend": "vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:workflows:types": "tsc --project tsconfig.tests.json",
    "test:providers:types": "tsc --project tsconfig.provider-tests.json",
    "baseline": "node scripts/baseline/run.mjs",
    "profile": "npm run checks:prepare && node scripts/baseline/profile-run.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "jsdom": "27.4.0",
    "marked": "18.1.3",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "5.1.0",
    "wrangler": "^4.0.0"
  }
}
