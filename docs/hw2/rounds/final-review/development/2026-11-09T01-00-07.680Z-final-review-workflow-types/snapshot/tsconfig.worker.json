{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src/worker",
    "outDir": "dist/worker",
    "declaration": false,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src/worker/**/*.ts", "worker-configuration.d.ts"]
}
