{
  "name": "ai-research-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local scaffold for the AI Research Assistant.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names worker,frontend --prefix-colors magenta,cyan \"npm run dev:worker\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:worker": "wrangler dev --config wrangler.jsonc --local --persist-to .wrangler/state --port 8787",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --config wrangler.jsonc --local --persist-to .wrangler/state",
    "worker:types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc",
    "storage:check": "node scripts/storage-check.mjs",
    "integrations": "node scripts/integration-check.mjs",
    "integrations:offline": "node scripts/integration-offline-check.mjs",
    "papers:check": "node scripts/paper-search-check.mjs",
    "papers:live": "node scripts/paper-search-live-check.mjs",
    "papers:ui:check": "node scripts/frontend-search-browser-check.mjs",
    "documents:check": "node scripts/document-check.mjs",
    "extractions:check": "node scripts/extraction-check.mjs",
    "metadata:check": "node scripts/metadata-check.mjs",
    "metadata:live": "node scripts/metadata-live-check.mjs",
    "unpdf:proof": "node scripts/unpdf-worker-proof.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.worker.json && tsc --noEmit --project tsconfig.vite.json",
    "build": "npm run typecheck && npm run build:frontend && npm run build:worker && npm run build:sites",
    "build:sites": "node scripts/prepare-sites-build.mjs",
    "sites": "npm run sites:check",
    "sites:check": "node scripts/sites-artifact-check.mjs",
    "build:frontend": "vite build",
    "build:worker": "node scripts/build-worker.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
